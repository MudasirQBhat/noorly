# Backend (Render) — REQUIRED in production, or the admin API stays disabled.
# Use a long random string, e.g. `openssl rand -base64 24`
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Optional: override the derived admin token with your own random value
# ADMIN_TOKEN=

# Frontend (Vercel) — only needed for the admin video download to reach Render
# VITE_API_BASE=https://noorly-api.onrender.com
